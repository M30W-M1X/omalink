[Unit]
Description=Omarchy Wizard Agent Bridge (Remote AI Agent Controller)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/Projects/omarchy_wizard/bridge/omarchy_wizard_bridge.py --host 0.0.0.0 --port 7842
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
