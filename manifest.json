{
  "schemaVersion": 1,
  "id": "omalink.panel",
  "name": "OmaLink",
  "version": "3.7.2",
  "author": "M30W-M1X",
  "license": "MIT",
  "description": "Android Continuity, Remote Desktop, Trackpad, OS Control, and AI Agent companion bridge for Omarchy Linux.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "omarchy-plugin/Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaLink",
    "description": "Shows OmaLink bridge status, pairing QR code, phone battery, quick message replies, and lets you start or stop the companion bridge.",
    "category": "Status",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 7842,
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "Bridge port",
        "min": 1024,
        "max": 65535,
        "step": 1,
        "defaultValue": 7842
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
