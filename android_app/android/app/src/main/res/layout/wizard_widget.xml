<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wizard_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OMARCHY WIZARD"
        android:textColor="#7DCFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#232942"
            android:text="Play"
            android:textColor="#E2E8FA"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_mute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#232942"
            android:text="Mute"
            android:textColor="#E2E8FA"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#232942"
            android:text="Lock"
            android:textColor="#BB9AF7"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_sudo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#232942"
            android:text="Sudo"
            android:textColor="#9ECE6A"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
